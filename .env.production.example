# Production settings for the single-server deployment (infra/docker-compose.prod.yml).
# Copy to .env on the server, fill in, and never commit the result.

# --- Site -------------------------------------------------------------------
# Your domain. Caddy fetches an HTTPS certificate for it automatically; its DNS
# A record must point at the server before the first start.
SITE_ADDRESS=airwatch.example.in
CORS_ALLOWED_ORIGINS=https://airwatch.example.in
NODE_ID=airwatch-india
NODE_NAME=AirWatch pilot network
NODE_OPERATOR=Your name or organisation

# --- Secrets you generate ---------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32  (keep it; operators sign in with it)
OPERATOR_API_KEY=

# --- Upstream keys ----------------------------------------------------------
OPENAQ_API_KEY=
CPCB_API_KEY=
FIRMS_MAP_KEY=

# Earth Engine: copy the service-account JSON to secrets/gee-key.json on the
# server. Leave all three empty to run without satellite data.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_PATH=/run/secrets/airwatch/gee-key.json
GEE_PROJECT_ID=

# --- Optional ---------------------------------------------------------------
# Where alerts are POSTed. Empty records alerts without claiming to send them.
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
