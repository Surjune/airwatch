*.joblib
*.pkl
*.onnx
*.pt

# --- Raw downloaded data (never committed) ---
data/raw/
data/cache/
*.grib
*.nc
*.hdf

# --- Federated round state ---
federated/state/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
