# --- Database ---------------------------------------------------------------
POSTGRES_USER=airwatch
POSTGRES_PASSWORD=airwatch
POSTGRES_DB=airwatch
# 5433/6380 avoid clashing with any Postgres/Redis already running locally.
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql+psycopg://airwatch:airwatch@localhost:5433/airwatch
REDIS_URL=redis://localhost:6380/0

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# --- Federated node identity ------------------------------------------------
# How this deployment identifies itself when exchanging observations or models
# with another city's node. Change these before running as a real node: a
# partner receiving data has to know whose it is.
NODE_ID=airwatch-delhi
NODE_NAME=AirWatch Delhi-NCR
NODE_OPERATOR=Unattributed development deployment
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Upstream data sources --------------------------------------------------
# Missing credentials raise a typed error. They never yield placeholder
# readings: in a public-health context a wrong number is worse than an error.

# https://explore.openaq.org -> Settings
OPENAQ_API_KEY=
# https://data.gov.in -> register -> API key (CPCB real-time AQI resource)
CPCB_API_KEY=
# https://firms.modaps.eosdis.nasa.gov/api/area/ -> request MAP_KEY
FIRMS_MAP_KEY=
# Open-Meteo needs no key.

# --- Optional, Phase 5 ------------------------------------------------------
# Sentinel-5P via Google Earth Engine. Requires a service account.
#   GEE_SERVICE_ACCOUNT_EMAIL is the "client_email" field inside the downloaded
#   JSON key, of the form <name>@<project>.iam.gserviceaccount.com.
#   GEE_PRIVATE_KEY_PATH is the path to that JSON file on disk, not a value
#   copied out of it. Keep the file outside this repository: Google names the
#   download after the project, so it matches none of the .gitignore patterns
#   for key files and a stray copy inside the repo could be committed.
#   GEE_PROJECT_ID is the "project_id" field; Earth Engine has required a
#   registered Cloud project since November 2024.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_PATH=
GEE_PROJECT_ID=
