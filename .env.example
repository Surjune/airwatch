# --- Database ---------------------------------------------------------------
POSTGRES_USER=airwatch
POSTGRES_PASSWORD=airwatch
POSTGRES_DB=airwatch
# 5433/6380 avoid clashing with any Postgres/Redis already running locally.
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql+psycopg://airwatch:airwatch@localhost:5433/airwatch
REDIS_URL=redis://localhost:6380/0

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Upstream data sources --------------------------------------------------
# Missing credentials raise a typed error. They never yield placeholder
# readings: in a public-health context a wrong number is worse than an error.

# https://explore.openaq.org -> Settings
OPENAQ_API_KEY=
# https://data.gov.in -> register -> API key (CPCB real-time AQI resource)
CPCB_API_KEY=
# https://firms.modaps.eosdis.nasa.gov/api/area/ -> request MAP_KEY
FIRMS_MAP_KEY=
# Open-Meteo needs no key.

# --- Optional, Phase 5 ------------------------------------------------------
# Sentinel-5P via Google Earth Engine. Requires a service account.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_PATH=
